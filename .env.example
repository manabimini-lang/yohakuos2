# ── Database (Prisma / PostgreSQL / Supabase Connection) ──────────
DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/DATABASE?pgbouncer=true&connection_limit=1
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# ── Supabase (Client integration) ────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# ── Background Jobs / Cron ───────────────────────────────────────
CRON_SECRET=your-random-cron-secret-32-chars

# ── Gemini API (AI Features) ─────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key

# ── NextAuth.js ──────────────────────────────────────────────────
NEXTAUTH_SECRET=your-nextauth-secret-32-chars-or-more
NEXTAUTH_URL=https://yohakuos2.vercel.app
# Note: Google OAuth callback URL for Gemini connection is:
# ${NEXTAUTH_URL}/api/gemini/callback

# ── Google OAuth ─────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ── Stripe (Payment Flow) ───────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_... (if webhooks are deployed)

# ── Discord Integration ──────────────────────────────────────────
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
