generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  extensions = [vector]
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  EDITOR
  PAID_MEMBER
  FREE_MEMBER
}

enum ContentType {
  ARTICLE
  VIDEO
  TASK
  UPDATE
}

enum ContentVisibility {
  PUBLIC
  FREE
  PAID
  ADMIN
}

enum PublishStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
}

enum ContentLayer {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum CardStyle {
  COMPACT
  DEFAULT
  COMFORTABLE
}

// ===================================================
// YOHAKU RBAC — Role & Permission Models
// ===================================================

model SystemRoleAssignment {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  role       String // "user" | "moderator" | "admin" | "owner"
  assignedBy String?  @map("assigned_by")
  createdAt  DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
  @@index([userId])
  @@index([role])
  @@map("system_role_assignments")
}

model Permission {
  id          String   @id @default(cuid())
  permission  String   @unique // "read_reports" | "manage_reports" | etc.
  label       String
  description String?
  category    String // "moderation" | "administration" | "billing" | "ai" | "analytics" | "system"
  createdAt   DateTime @default(now()) @map("created_at")

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  id           String   @id @default(cuid())
  role         String // "user" | "moderator" | "admin" | "owner"
  permissionId String   @map("permission_id")
  createdAt    DateTime @default(now()) @map("created_at")

  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([role, permissionId])
  @@index([role])
  @@index([permissionId])
  @@map("role_permissions")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  password      String?
  name          String?
  image         String?
  emailVerified DateTime? @map("email_verified")
  role          UserRole  @default(FREE_MEMBER)
  planType      String?   @map("plan_type")
  plan          String    @default("free") @map("plan")
  discordId     String?   @map("discord_id")
  discordName   String?   @map("discord_name")
  discordAvatar String?   @map("discord_avatar")

  // RBAC — System Roles (new permission-based system)
  systemRoleAssignments SystemRoleAssignment[]

  // Settings & Integrations
  userApiKeys    UserApiKey[]
  userAiSettings UserAISettings?

  // Stripe Subscription
  subscription Subscription?

  // Audit Trail
  auditLogs AuditLog[]

  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  contents       Content[]
  progress       UserProgress[]
  accounts       Account[]
  sessions       Session[]
  dailyLogs      DailyLog[]
  reflections    Reflection[]
  userMemories   UserMemory[]
  knowledgeCards KnowledgeCard[]

  // Life OS Layer relations
  ambientInsights        AmbientInsight[]
  resonancePatterns      ResonancePattern[]
  slowFeedEntries        SlowFeedEntry[]
  lifeAreas              LifeArea[]
  habitFlows             HabitFlow[]
  lifeReflections        LifeReflection[]
  energyStates           EnergyState[]
  meaningSignals         MeaningSignal[]
  lifeBalances           LifeBalance[]
  directionReflections   DirectionReflection[]
  quietPlans             QuietPlan[]
  emotionalCooldowns     EmotionalCooldown[]
  roadHistories          RoadHistory[]
  roadTransitions        RoadTransition[]
  seasonalSummaries      SeasonalSummary[]
  companionConversations CompanionConversation[]

  // Security & Admin
  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime? @map("locked_until")
  mfaSecret           String?   @map("mfa_secret")
  mfaEnabled          Boolean   @default(false) @map("mfa_enabled")

  contentItems ContentItem[]

  @@map("users")
}

model UserApiKey {
  id           String   @id @default(cuid())
  userId       String   @map("user_id")
  apiProvider  String   @default("gemini") @map("api_provider")
  encryptedKey String   @map("encrypted_key")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, apiProvider])
  @@map("user_api_keys")
}

model UserAISettings {
  id              String  @id @default(cuid())
  userId          String  @unique @map("user_id")
  provider        String  @default("gemini")
  encryptedApiKey String? @map("encrypted_api_key")
  model           String?
  embeddingsModel String? @map("embeddings_model")
  isEnabled       Boolean @default(false) @map("is_enabled")

  // Usage Protection (利用量制限)
  dailyTokenUsage   Int       @default(0) @map("daily_token_usage")
  monthlyTokenUsage Int       @default(0) @map("monthly_token_usage")
  lastUsageReset    DateTime? @map("last_usage_reset")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_ai_settings")
}

model DailyLog {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  moodTag     String?  @map("mood_tag")
  inputText   String   @map("input_text") @db.Text
  aiResponse  String?  @map("ai_response") @db.Text
  smallAction String?  @map("small_action")
  createdAt   DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@map("daily_logs")
}

model Reflection {
  id             String @id @default(cuid())
  userId         String @map("user_id")
  reflectionText String @map("reflection_text") @db.Text

  // AI Memory Fields
  title         String?
  content       String?  @db.Text
  type          String? // 'user', 'ai_insight', 'weekly', 'pattern'
  confidence    Float?
  triggeredBy   String[] // Array of UserMemory IDs
  sentiment     String?
  promptVersion String?  @map("prompt_version")

  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@map("reflections")
}

model Subscription {
  id                   String    @id @default(cuid())
  userId               String    @unique @map("user_id")
  stripeCustomerId     String?   @unique @map("stripe_customer_id")
  stripeSubscriptionId String?   @unique @map("stripe_subscription_id")
  stripePriceId        String?   @map("stripe_price_id")
  status               String    @default("incomplete")
  currentPeriodEnd     DateTime? @map("current_period_end")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
  @@map("subscriptions")
}

model Content {
  id            String            @id @default(cuid())
  title         String
  slug          String            @unique
  description   String?
  thumbnailUrl  String?           @map("thumbnail_url")
  content       String?
  contentType   ContentType       @map("content_type")
  visibility    ContentVisibility
  publishStatus PublishStatus     @default(DRAFT) @map("publish_status")
  layer         ContentLayer
  releaseDate   DateTime?         @map("release_date")
  createdBy     String            @map("created_by")
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")
  author        User              @relation(fields: [createdBy], references: [id], onDelete: Restrict)
  tags          ContentTag[]
  progress      UserProgress[]

  @@index([createdBy])
  @@map("contents")
}

model Tag {
  id       String       @id @default(cuid())
  name     String
  slug     String       @unique
  contents ContentTag[]

  @@map("tags")
}

model ContentTag {
  contentId String  @map("content_id")
  tagId     String  @map("tag_id")
  content   Content @relation(fields: [contentId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([contentId, tagId])
  @@index([tagId])
  @@map("content_tags")
}

model UserProgress {
  id          String    @id @default(cuid())
  userId      String    @map("user_id")
  contentId   String    @map("content_id")
  completed   Boolean   @default(false)
  completedAt DateTime? @map("completed_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  content     Content   @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@unique([userId, contentId])
  @@index([contentId])
  @@map("user_progress")
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ===================================================
// YOHAKU Safety Engine — Risk Review Queue
// ===================================================

model RiskReview {
  id           String   @id @default(cuid())
  userId       String   @map("user_id")
  assessmentId String   @map("assessment_id")
  riskLevel    String   @map("risk_level") // "low" | "medium" | "high" | "critical"
  riskScore    Float    @map("risk_score")
  signals      Json     @default("[]") @db.JsonB
  status       String   @default("pending") // "pending" | "in_review" | "resolved" | "escalated"
  assignedTo   String?  @map("assigned_to")
  notes        String?  @db.Text
  resolution   String?  @db.Text
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@index([status])
  @@index([assignedTo])
  @@index([riskLevel])
  @@map("risk_reviews")
}

model SiteSettings {
  id              String    @id @default("global")
  siteTitle       String    @default("YOHAKU")
  siteDescription String    @default("学びを、余白のある習慣に。") @map("site_description")
  logoUrl         String?   @map("logo_url")
  primaryColor    String    @default("#0f172a") @map("primary_color")
  cardStyle       CardStyle @default(DEFAULT) @map("card_style")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@map("site_settings")
}

// ===================================================
// YOHAKU Operational State — State Transitions
// ===================================================
//
// IMMUTABLE DESIGN: Records must never be updated or deleted.
// This is an append-only log of all state transitions.
// ===================================================

model StateTransition {
  id         String   @id @default(cuid())
  entityType String   @map("entity_type") // "user" | "moderation" | "subscription" | "safety"
  entityId   String   @map("entity_id")
  fromState  String   @map("from_state")
  toState    String   @map("to_state")
  reason     String
  actorId    String?  @map("actor_id")
  metadata   Json?    @default("{}") @db.JsonB
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([entityType, entityId])
  @@index([entityType, entityId, createdAt])
  @@index([actorId])
  @@index([createdAt])
  @@map("state_transitions")
}

// ===================================================
// YOHAKU Audit & Security — Audit Log
// ===================================================
//
// IMMUTABLE DESIGN: Records must never be updated or deleted.
// This is an append-only log for security, compliance, and forensics.
// ===================================================

model AuditLog {
  id         String  @id @default(cuid())
  actorId    String? @map("actor_id")
  category   String // "auth" | "moderation" | "billing" | "ai" | "admin" | "security" | "user_management"
  action     String // e.g. "user.login", "role.change", "moderation.resolve"
  targetType String? @map("target_type") // e.g. "user", "content", "report", "role"
  targetId   String? @map("target_id")
  severity   String  @default("info") // "info" | "warning" | "error" | "critical"

  // Structured metadata as JSON (generic, flexible for future events)
  metadata Json? @default("{}") @db.JsonB

  // Security context
  ipAddress String? @map("ip_address")
  userAgent String? @map("user_agent")
  sessionId String? @map("session_id")

  // Actor relation (nullable for system actions)
  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([actorId])
  @@index([category])
  @@index([action])
  @@index([createdAt])
  @@index([category, createdAt])
  @@index([actorId, createdAt])
  @@map("audit_logs")
}

model SharedKnowledge {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title     String
  summary   String
  tags      Json     @default("[]")
  road      String
  createdBy String   @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  @@map("shared_knowledge")
}

model ExternalContent {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title        String
  url          String
  thumbnailUrl String?  @map("thumbnail_url")
  type         String
  road         String
  tags         Json     @default("[]")
  description  String?
  createdAt    DateTime @default(now()) @map("created_at")
  createdBy    String   @map("created_by") @db.Uuid

  @@map("external_contents")
}

model SuggestedContent {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title       String
  url         String
  type        String
  road        String
  tags        Json     @default("[]")
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  createdBy   String   @map("created_by") @db.Uuid

  @@map("suggested_contents")
}

model Road {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug        String   @unique
  title       String
  description String
  icon        String
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")

  roadPrompt RoadPrompt?

  @@map("roads")
}

model RoadPrompt {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  roadId       String   @unique @map("road_id") @db.Uuid
  systemPrompt String   @map("system_prompt") @db.Text
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  road Road @relation(fields: [roadId], references: [id], onDelete: Cascade)

  @@map("road_prompts")
}

// ===================================================
// YOHAKU Life OS Layer — Life Timeline / Areas / Meaning / Energy / Habit
// ===================================================

enum LifeAreaType {
  Health
  Learning
  Work
  Creativity
  Relationships
  Mind
  Rest
  Challenge
}

model LifeArea {
  id          String       @id @default(cuid())
  userId      String       @map("user_id")
  type        LifeAreaType
  title       String
  description String?      @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type])
  @@index([userId])
  @@map("life_areas")
}

enum HabitFlowStatus {
  active
  paused
  completed
  naturally_ended
}

model HabitFlow {
  id        String          @id @default(cuid())
  userId    String          @map("user_id")
  title     String
  category  String?
  status    HabitFlowStatus @default(active)
  intensity Int             @default(1) // 1-5 scale
  areaType  LifeAreaType?   @map("area_type")

  startedAt DateTime  @default(now()) @map("started_at")
  endedAt   DateTime? @map("ended_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([userId, areaType])
  @@map("habit_flows")
}

enum LifeReflectionType {
  weekly
  monthly
  seasonal
  half_year
  yearly
  goal
}

model LifeReflection {
  id         String             @id @default(cuid())
  userId     String             @map("user_id")
  type       LifeReflectionType
  title      String
  content    String             @db.Text
  confidence Float              @default(0.5)

  sourceIds String[]      @map("source_ids")
  areaType  LifeAreaType? @map("area_type")

  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@index([userId, createdAt])
  @@map("life_reflections")
}

enum EnergyStateType {
  calm_focus
  exhaustion
  recovery
  curiosity
  instability
  groundedness
}

model EnergyState {
  id                 String          @id @default(cuid())
  userId             String          @map("user_id")
  state              EnergyStateType
  intensity          Int             @default(3) // 1-10 scale
  sourceReflectionId String?         @map("source_reflection_id")

  note     String?       @db.Text
  areaType LifeAreaType? @map("area_type")

  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, state])
  @@index([userId, createdAt])
  @@map("energy_states")
}

model MeaningSignal {
  id          String        @id @default(cuid())
  userId      String        @map("user_id")
  signalType  String        @map("signal_type") // recurring_theme, unresolved_question, value_tension, long_term_curiosity, emotional_recurrence
  description String        @db.Text
  confidence  Float         @default(0.3)
  areaType    LifeAreaType? @map("area_type")

  relatedMemoryIds String[] @map("related_memory_ids")

  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, signalType])
  @@index([userId, confidence])
  @@map("meaning_signals")
}

// ===================================================
// Life Balance & Direction
// ===================================================

model LifeBalance {
  id         String @id @default(cuid())
  userId     String @map("user_id")
  analysis   String @db.Text
  signals    Json   @default("[]") @db.JsonB // Array of imbalance signals
  confidence Float  @default(0.3)

  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("life_balances")
}

model DirectionReflection {
  id         String  @id @default(cuid())
  userId     String  @map("user_id")
  direction  String  @db.Text
  intention  String  @db.Text
  values     Json    @default("[]") @db.JsonB
  quietWish  String? @map("quiet_wish") @db.Text
  confidence Float   @default(0.3)

  period    String   @default("current") // current, past, emerging
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, period])
  @@index([userId, createdAt])
  @@map("direction_reflections")
}

model QuietPlan {
  id        String  @id @default(cuid())
  userId    String  @map("user_id")
  intention String  @db.Text
  nextStep  String? @map("next_step") @db.Text
  note      String? @db.Text

  isOptional  Boolean @default(true) @map("is_optional")
  isCompleted Boolean @default(false) @map("is_completed")

  createdAt   DateTime  @default(now()) @map("created_at")
  completedAt DateTime? @map("completed_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("quiet_plans")
}

// ===================================================
// Conversation Compression Layer
// ===================================================

model ConversationSummary {
  id             String @id @default(cuid())
  conversationId String @map("conversation_id")
  summaryType    String @map("summary_type") // rolling, thematic, abstract, meaning
  content        String @db.Text
  tokenCount     Int    @default(0) @map("token_count")

  createdAt DateTime @default(now()) @map("created_at")

  conversation CompanionConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, summaryType])
  @@map("conversation_summaries")
}

model ConversationTheme {
  id             String @id @default(cuid())
  conversationId String @map("conversation_id")
  theme          String
  confidence     Float  @default(0.5)

  createdAt DateTime @default(now()) @map("created_at")

  conversation CompanionConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@map("conversation_themes")
}

model ConversationInsight {
  id             String @id @default(cuid())
  conversationId String @map("conversation_id")
  insight        String @db.Text
  confidence     Float  @default(0.5)

  createdAt DateTime @default(now()) @map("created_at")

  conversation CompanionConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@map("conversation_insights")
}

// ===================================================
// Emotional Cooldown System
// ===================================================

model EmotionalCooldown {
  id           String  @id @default(cuid())
  userId       String  @map("user_id")
  cooldownType String  @map("cooldown_type") // emotional_overload, anxiety_repetition, reflection_cooldown
  intensity    Int     @default(3) // 1-10
  sourceId     String? @map("source_id")

  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, cooldownType])
  @@index([userId, expiresAt])
  @@map("emotional_cooldowns")
}

// ===================================================
// Road Context Persistence
// ===================================================

model RoadHistory {
  id        String  @id @default(cuid())
  userId    String  @map("user_id")
  roadSlug  String  @map("road_slug")
  roadTitle String  @map("road_title")
  roadIcon  String? @map("road_icon")

  startedAt DateTime  @default(now()) @map("started_at")
  endedAt   DateTime? @map("ended_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("road_histories")
}

model RoadTransition {
  id         String  @id @default(cuid())
  userId     String  @map("user_id")
  fromRoad   String  @map("from_road")
  toRoad     String  @map("to_road")
  reflection String? @db.Text

  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("road_transitions")
}

model SeasonalSummary {
  id         String @id @default(cuid())
  userId     String @map("user_id")
  period     String @map("period") // spring_2026, summer_2026, etc.
  season     String @map("season") // spring, summer, autumn, winter
  year       Int    @map("year")
  summary    String @db.Text
  themes     Json   @default("[]") @db.JsonB
  confidence Float  @default(0.4)

  startDate DateTime @map("start_date")
  endDate   DateTime @map("end_date")

  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, period])
  @@index([userId])
  @@map("seasonal_summaries")
}

model LegacySnapshot {
