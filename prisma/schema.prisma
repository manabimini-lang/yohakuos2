model AmbientInsight {
  id              String   @id @default(cuid())
  userId          String   @map("user_id")
  type            String   @map("type") // seasonal_echo, memory_resonance, reflection_bridge, theme_recurrence, quiet_discovery
  title           String
  content         String   @db.Text
  sourceMemoryIds String[] @map("source_memory_ids")
  confidence      Float    @default(0.3)

  surfacedAt  DateTime  @map("surfaced_at")
  dismissedAt DateTime? @map("dismissed_at")

  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@index([userId, surfacedAt])
  @@index([userId, confidence])
  @@map("ambient_insights")
}

model ResonancePattern {
  id          String @id @default(cuid())
  userId      String @map("user_id")
  patternType String @map("pattern_type") // seasonal_recurrence, emotional_cycle, behavioral_loop, thematic_return, value_consistency
  description String @db.Text
  confidence  Float  @default(0.3)

  sourceMemoryIds String[] @map("source_memory_ids")
  evidenceIds     String[] @map("evidence_ids")

  firstObservedAt DateTime @map("first_observed_at")
  observedCount   Int      @default(1) @map("observed_count")
  lastObservedAt  DateTime @map("last_observed_at")

  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, patternType, firstObservedAt])
  @@index([userId, patternType])
  @@index([userId, confidence])
  @@map("resonance_patterns")
}

model SlowFeedEntry {
  id         String  @id @default(cuid())
  userId     String  @map("user_id")
  entryType  String  @map("entry_type") // insight, resonance, reflection, seasonal_echo, quiet_connection
  title      String
  content    String  @db.Text
  sourceType String? @map("source_type") // ambient_insight, resonance_pattern, life_reflection, meaning_signal, seasonal_summary
  sourceId   String? @map("source_id")

  isRead  Boolean @default(false) @map("is_read")
  isSaved Boolean @default(false) @map("is_saved")

  confidence Float @default(0.3)
  priority   Int   @default(0) // 0-5, 0=lowest

  surfacedAt DateTime  @default(now()) @map("surfaced_at")
  readAt     DateTime? @map("read_at")

  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt])
  @@index([userId, priority, surfacedAt])
  @@index([userId, entryType])
  @@map("slow_feed_entries")
}

// ===================================================
// YOHAKU Personal Knowledge Memory Layer
// ===================================================

enum KnowledgeCardType {
  url
  text
  youtube
  pdf
  voice
  web_clipping
  ai_conversation
  reflection
}

model KnowledgeCard {
  id       String            @id @default(cuid())
  userId   String            @map("user_id")
  type     KnowledgeCardType
  source   String? // 元URL、ファイルパスなど
  title    String?
  content  String            @db.Text
  metadata Json?             @db.JsonB

  summary String?  @db.Text
  tags    String[]

  userMemories  UserMemory[]
  memorySources MemorySource[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, type])
  @@index([userId, createdAt])
  @@map("knowledge_cards")
}

enum MemoryType {
  value
  belief
  goal
  fear
  motivation
  learning_style
  habit
  personality_trait
  reflection
  emotional_pattern
  life_theme
  behavior_pattern
  thinking_pattern
}

model UserMemory {
  id         String     @id @default(cuid())
  userId     String     @map("user_id")
  type       MemoryType
  category   String?
  title      String
  content    String     @db.Text
  confidence Float      @default(0.5)

  fingerprint  String? @unique
  version      Int     @default(1)
  supersededId String? @map("superseded_id")

  sourceCard   KnowledgeCard? @relation(fields: [sourceCardId], references: [id], onDelete: SetNull)
  sourceCardId String?        @map("source_card_id")
  sources      MemorySource[]

  promptVersion String? @map("prompt_version")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@index([userId, confidence])
  @@index([userId, type, confidence])
  @@index([fingerprint])
  @@map("user_memories")
}

model MemoryGraphEdge {
  id             String   @id @default(cuid())
  userId         String   @map("user_id")
  fromContentId  String   @map("from_content_id")
  toContentId    String   @map("to_content_id")
  edgeType       String   @map("edge_type")
  weight         Float    @default(0.0)
  reason         String?  @db.Text
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([fromContentId])
  @@index([toContentId])
  @@index([userId, edgeType])
  @@unique([userId, fromContentId, toContentId, edgeType])
  @@map("memory_graph_edges")
}

model PhilosophyFragment {
  id             String   @id @default(cuid())
  userId         String   @map("user_id")
  fragment       String   @db.Text
  sourceType     String   @map("source_type")
  resonanceScore Float    @map("resonance_score")
  relatedTheme   String?  @map("related_theme")
  createdAt      DateTime @default(now()) @map("created_at")

  @@unique([userId, fragment])
  @@index([userId])
  @@map("philosophy_fragments")
}

model IdentitySnapshot {
  id      String @id @default(cuid())
  userId  String @map("user_id")
  period  String
  label   String
  summary String @db.Text
  traits  Json   @db.JsonB

  startDate DateTime  @map("start_date")
  endDate   DateTime? @map("end_date")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, period])
  @@index([userId, startDate])
  @@map("identity_snapshots")
}

model MemorySource {
  id       String @id @default(cuid())
  memoryId String @map("memory_id")
  cardId   String @map("card_id")

  memory UserMemory    @relation(fields: [memoryId], references: [id], onDelete: Cascade)
  card   KnowledgeCard @relation(fields: [cardId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([memoryId, cardId])
  @@index([cardId])
  @@index([memoryId])
  @@map("memory_sources")
}

// ===================================================
// YOHAKU AI Companion Layer
// ===================================================

model CompanionConversation {
  id             String @id @default(cuid())
  userId         String @map("user_id")
  title          String @default("")
  contextVersion Int    @default(1) @map("context_version")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user      User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  CompanionMessage[]
  summaries ConversationSummary[]
  themes    ConversationTheme[]
  insights  ConversationInsight[]

  @@index([userId])
  @@index([userId, createdAt])
  @@map("companion_conversations")
}

enum MessageRole {
  user
  assistant
  system
}

model CompanionMessage {
  id             String      @id @default(cuid())
  conversationId String      @map("conversation_id")
  role           MessageRole
  content        String      @db.Text
  tokenCount     Int         @default(0) @map("token_count")
  memorySnapshot Json?       @map("memory_snapshot") @db.JsonB

  conversation CompanionConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([conversationId])
  @@index([conversationId, createdAt])
  @@map("companion_messages")
}

enum JobStatus {
  pending
  processing
  completed
  failed
  deduped
}

model AIJob {
  id       String    @id @default(cuid())
  userId   String    @map("user_id")
  jobType  String    @map("job_type")
  status   JobStatus @default(pending)
  priority Int       @default(0)

  input  Json  @db.JsonB
  output Json? @db.JsonB

  lastError  String? @map("last_error") @db.Text
  retryCount Int     @default(0) @map("retry_count")
  maxRetries Int     @default(3) @map("max_retries")

  tokenUsed    Int?   @map("token_used")
  costEstimate Float? @map("cost_estimate")

  scheduledAt DateTime? @map("scheduled_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  startedAt   DateTime? @map("started_at")
  processedAt DateTime? @map("processed_at")
  completedAt DateTime? @map("completed_at")

  @@index([userId, status])
  @@index([status, priority, createdAt])
  @@index([status, createdAt])
  @@map("ai_jobs")
}

