generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  EDITOR
  PAID_MEMBER
  FREE_MEMBER
}

enum ContentType {
  ARTICLE
  VIDEO
  TASK
  UPDATE
}

enum ContentVisibility {
  PUBLIC
  FREE
  PAID
  ADMIN
}

enum PublishStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
}

enum ContentLayer {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum CardStyle {
  COMPACT
  DEFAULT
  COMFORTABLE
}

model User {
  id                     String         @id @default(cuid())
  email                  String         @unique
  password               String?
  name                   String?
  image                  String?
  emailVerified          DateTime?      @map("email_verified")
  role                   UserRole       @default(FREE_MEMBER)
  planType               String?        @map("plan_type")
  plan                   String         @default("free") @map("plan")
  discordId              String?        @map("discord_id")
  discordName            String?        @map("discord_name")
  discordAvatar          String?        @map("discord_avatar")

  // Settings & Integrations
  userApiKeys            UserApiKey[]
  
  // Stripe Subscription
  subscription           Subscription?
  
  createdAt              DateTime       @default(now()) @map("created_at")
  updatedAt              DateTime       @updatedAt @map("updated_at")
  contents               Content[]
  progress               UserProgress[]
  accounts               Account[]
  sessions               Session[]
  dailyLogs              DailyLog[]
  reflections            Reflection[]

  // Security & Admin
  failedLoginAttempts    Int       @default(0) @map("failed_login_attempts")
  lockedUntil            DateTime? @map("locked_until")
  mfaSecret              String?   @map("mfa_secret")
  mfaEnabled             Boolean   @default(false) @map("mfa_enabled")

  @@map("users")
}

model UserApiKey {
  id           String   @id @default(cuid())
  userId       String   @map("user_id")
  apiProvider  String   @default("gemini") @map("api_provider")
  encryptedKey String   @map("encrypted_key")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, apiProvider])
  @@map("user_api_keys")
}

model DailyLog {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  moodTag     String?  @map("mood_tag")
  inputText   String   @db.Text @map("input_text")
  aiResponse  String?  @db.Text @map("ai_response")
  smallAction String?  @map("small_action")
  createdAt   DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@map("daily_logs")
}

model Reflection {
  id             String   @id @default(cuid())
  userId         String   @map("user_id")
  reflectionText String   @db.Text @map("reflection_text")
  createdAt      DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@map("reflections")
}

model Subscription {
  id                   String    @id @default(cuid())
  userId               String    @unique @map("user_id")
  stripeCustomerId     String?   @unique @map("stripe_customer_id")
  stripeSubscriptionId String?   @unique @map("stripe_subscription_id")
  stripePriceId        String?   @map("stripe_price_id")
  status               String    @default("incomplete")
  currentPeriodEnd     DateTime? @map("current_period_end")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
  @@map("subscriptions")
}

model Content {
  id            String          @id @default(cuid())
  title         String
  slug          String          @unique
  description   String?
  thumbnailUrl  String?         @map("thumbnail_url")
  content       String?
  contentType   ContentType     @map("content_type")
  visibility    ContentVisibility
  publishStatus PublishStatus   @default(DRAFT) @map("publish_status")
  layer         ContentLayer
  releaseDate   DateTime?       @map("release_date")
  createdBy     String          @map("created_by")
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")
  author        User            @relation(fields: [createdBy], references: [id], onDelete: Restrict)
  tags          ContentTag[]
  progress      UserProgress[]

  @@index([createdBy])
  @@map("contents")
}

model Tag {
  id       String       @id @default(cuid())
  name     String
  slug     String       @unique
  contents ContentTag[]

  @@map("tags")
}

model ContentTag {
  contentId String  @map("content_id")
  tagId     String  @map("tag_id")
  content   Content @relation(fields: [contentId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([contentId, tagId])
  @@index([tagId])
  @@map("content_tags")
}

model UserProgress {
  id          String    @id @default(cuid())
  userId      String    @map("user_id")
  contentId   String    @map("content_id")
  completed   Boolean   @default(false)
  completedAt DateTime? @map("completed_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  content     Content   @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@unique([userId, contentId])
  @@index([contentId])
  @@map("user_progress")
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model SiteSettings {
  id              String    @id @default("global")
  siteTitle       String    @default("YOHAKU")
  siteDescription String    @default("学びを、余白のある習慣に。") @map("site_description")
  logoUrl         String?   @map("logo_url")
  primaryColor    String    @default("#0f172a") @map("primary_color")
  cardStyle       CardStyle @default(DEFAULT) @map("card_style")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@map("site_settings")
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?  @map("user_id")
  action    String
  resource  String
  ipAddress String?  @map("ip_address")
  details   String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([createdAt])
  @@map("audit_logs")
}

model SharedKnowledge {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title     String
  summary   String
  tags      Json     @default("[]")
  road      String
  createdBy String   @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  @@map("shared_knowledge")
}

model ExternalContent {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title        String
  url          String
  thumbnailUrl String?  @map("thumbnail_url")
  type         String
  road         String
  tags         Json     @default("[]")
  description  String?
  createdAt    DateTime @default(now()) @map("created_at")
  createdBy    String   @map("created_by") @db.Uuid

  @@map("external_contents")
}

model SuggestedContent {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title        String
  url          String
  type         String
  road         String
  tags         Json     @default("[]")
  description  String?
  createdAt    DateTime @default(now()) @map("created_at")
  createdBy    String   @map("created_by") @db.Uuid

  @@map("suggested_contents")
}

model Road {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug        String   @unique
  title       String
  description String
  icon        String
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")

  roadPrompt  RoadPrompt?

  @@map("roads")
}

model RoadPrompt {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  roadId       String   @unique @map("road_id") @db.Uuid
  systemPrompt String   @map("system_prompt") @db.Text
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  road Road @relation(fields: [roadId], references: [id], onDelete: Cascade)

  @@map("road_prompts")
}


